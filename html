<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Descubra seu Signo Zodiacal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5">
                <div class="card shadow-lg border-0 zodiac-card">
                    <div class="card-body p-5 text-center">
                        <h1 class="mb-4 display-5 fw-bold text-primary">✨ Descubra seu Signo</h1>
                        <p class="lead text-muted mb-4">Insira sua data de nascimento para conhecer as principais características do seu signo zodiacal.</p>
                        
                        <form id="formSigno">
                            <div class="mb-4">
                                <label for="dataNasc" class="form-label fw-semibold">Data de Nascimento</label>
                                <input type="date" class="form-control form-control-lg" id="dataNasc" required>
                            </div>
                            <button type="submit" class="btn btn-primary btn-lg w-100 rounded-pill">
                                Descobrir meu Signo
                            </button>
                        </form>
                        
                        <p class="mt-4 small text-muted">Apenas o signo solar será calculado com base na data informada.</p>
                        <div class="mt-4">
                            <a href="compatibilidade.html" class="btn btn-outline-primary rounded-pill">Ver compatibilidade entre signos</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.getElementById("formSigno").addEventListener("submit", function(e) {
            e.preventDefault();
            const data = document.getElementById("dataNasc").value;
            if (data) {
                window.location.href = "resultado.html?data=" + encodeURIComponent(data);
            }
        });
    </script>
</body>
</html>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seu Signo Zodiacal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="card shadow-lg border-0 zodiac-card">
                    <div class="card-body p-5 text-center" id="resultado">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Carregando...</span>
                        </div>
                        <p class="mt-3">Calculando seu signo...</p>
                    </div>
                </div>
                <div class="text-center mt-4">
                    <a href="index.html" class="btn btn-outline-primary rounded-pill">← Nova consulta</a>
                </div>
            </div>
        </div>
    </div>

    <script>
        const signos = {
            aries: { nome: "Áries", simbolo: "♈", datas: "21 de março a 19 de abril", elemento: "Fogo", regente: "Marte", caracteristicas: "Corajoso, energético, líder nato, impulsivo e pioneiro. Gosta de desafios e toma a iniciativa." },
            touro: { nome: "Touro", simbolo: "♉", datas: "20 de abril a 20 de maio", elemento: "Terra", regente: "Vênus", caracteristicas: "Estável, paciente, determinado, apreciador de conforto e beleza. Muito leal e teimoso quando quer." },
            gemeos: { nome: "Gêmeos", simbolo: "♊", datas: "21 de maio a 20 de junho", elemento: "Ar", regente: "Mercúrio", caracteristicas: "Comunicativo, curioso, versátil, inteligente e sociável. Adora aprender coisas novas e conversar." },
            cancer: { nome: "Câncer", simbolo: "♋", datas: "21 de junho a 22 de julho", elemento: "Água", regente: "Lua", caracteristicas: "Emotivo, protetor, intuitivo, ligado à família e ao lar. Sensível e acolhedor." },
            leao: { nome: "Leão", simbolo: "♌", datas: "23 de julho a 22 de agosto", elemento: "Fogo", regente: "Sol", caracteristicas: "Carismático, generoso, confiante, criativo e líder natural. Gosta de ser o centro das atenções." },
            virgem: { nome: "Virgem", simbolo: "♍", datas: "23 de agosto a 22 de setembro", elemento: "Terra", regente: "Mercúrio", caracteristicas: "Organizado, analítico, prestativo, perfeccionista e prático. Excelente em detalhes e planejamento." },
            libra: { nome: "Libra", simbolo: "♎", datas: "23 de setembro a 22 de outubro", elemento: "Ar", regente: "Vênus", caracteristicas: "Diplomático, equilibrado, justo, elegante e sociável. Busca harmonia em todas as situações." },
            escorpiao: { nome: "Escorpião", simbolo: "♏", datas: "23 de outubro a 21 de novembro", elemento: "Água", regente: "Plutão", caracteristicas: "Intenso, misterioso, leal, determinado e apaixonado. Tem grande força emocional e intuição." },
            sagitario: { nome: "Sagitário", simbolo: "♐", datas: "22 de novembro a 21 de dezembro", elemento: "Fogo", regente: "Júpiter", caracteristicas: "Aventureiro, otimista, filosófico, sincero e independente. Ama liberdade e explorar o mundo." },
            capricornio: { nome: "Capricórnio", simbolo: "♑", datas: "22 de dezembro a 19 de janeiro", elemento: "Terra", regente: "Saturno", caracteristicas: "Disciplinado, responsável, ambicioso, paciente e prático. Focado em metas de longo prazo." },
            aquario: { nome: "Aquário", simbolo: "♒", datas: "20 de janeiro a 18 de fevereiro", elemento: "Ar", regente: "Urano", caracteristicas: "Original, independente, humanitário, inovador e amigável. Valoriza a liberdade e ideias novas." },
            peixes: { nome: "Peixes", simbolo: "♓", datas: "19 de fevereiro a 20 de março", elemento: "Água", regente: "Netuno", caracteristicas: "Sensível, empático, imaginativo, intuitivo e sonhador. Muito criativo e conectado às emoções." }
        };

        function calcularSigno(dataStr) {
            if (!dataStr || !dataStr.includes("-")) return null;
            
            const partes = dataStr.split("-");
            if (partes.length !== 3) return null;
            
            const mes = parseInt(partes[1], 10);
            const dia = parseInt(partes[2], 10);

            if (isNaN(mes) || isNaN(dia)) return null;

            if ((mes === 3 && dia >= 21) || (mes === 4 && dia <= 19)) return "aries";
            if ((mes === 4 && dia >= 20) || (mes === 5 && dia <= 20)) return "touro";
            if ((mes === 5 && dia >= 21) || (mes === 6 && dia <= 20)) return "gemeos";
            if ((mes === 6 && dia >= 21) || (mes === 7 && dia <= 22)) return "cancer";
            if ((mes === 7 && dia >= 23) || (mes === 8 && dia <= 22)) return "leao";
            if ((mes === 8 && dia >= 23) || (mes === 9 && dia <= 22)) return "virgem";
            if ((mes === 9 && dia >= 23) || (mes === 10 && dia <= 22)) return "libra";
            if ((mes === 10 && dia >= 23) || (mes === 11 && dia <= 21)) return "escorpiao";
            if ((mes === 11 && dia >= 22) || (mes === 12 && dia <= 21)) return "sagitario";
            if ((mes === 12 && dia >= 22) || (mes === 1 && dia <= 19)) return "capricornio";
            if ((mes === 1 && dia >= 20) || (mes === 2 && dia <= 18)) return "aquario";
            if ((mes === 2 && dia >= 19) || (mes === 3 && dia <= 20)) return "peixes";
            
            return null;
        }

        document.addEventListener("DOMContentLoaded", function() {
            const params = new URLSearchParams(window.location.search);
            const dataNasc = params.get("data");
            const resultadoDiv = document.getElementById("resultado");

            if (!dataNasc) {
                resultadoDiv.innerHTML = `<h2 class="text-danger">Data não informada</h2><p>Volte e informe uma data de nascimento válida.</p>`;
                return;
            }

            const chaveSigno = calcularSigno(dataNasc);
            
            if (!chaveSigno || !signos[chaveSigno]) {
                resultadoDiv.innerHTML = `<h2 class="text-warning">Não foi possível calcular</h2><p>Verifique se a data está correta e tente novamente.</p>`;
                return;
            }

            const signo = signos[chaveSigno];
            
            resultadoDiv.innerHTML = `
                <div class="signo-simbolo mb-3">${signo.simbolo}</div>
                <h1 class="display-4 fw-bold text-primary mb-2">${signo.nome}</h1>
                <p class="badge bg-secondary fs-6 mb-4">${signo.datas}</p>
                
                <div class="row text-start mt-4">
                    <div class="col-6 mb-3">
                        <strong>Elemento:</strong><br>
                        <span class="badge bg-info text-dark">${signo.elemento}</span>
                    </div>
                    <div class="col-6 mb-3">
                        <strong>Planeta Regente:</strong><br>
                        <span class="badge bg-warning text-dark">${signo.regente}</span>
                    </div>
                </div>
                
                <div class="mt-4 p-4 bg-light rounded">
                    <h5 class="mb-3">Principais Características</h5>
                    <p class="mb-0">${signo.caracteristicas}</p>
                </div>
            `;
        });
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
